import { DockEntry } from "models.slint";

export component DockWindow inherits Window {
    width: 740px;
    height: 96px;
    title: "LifeTrace Dock";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <[DockEntry]> entries;
    in property <bool> hover-enabled: true;
    callback activate(int);

    Rectangle {
        x: 2px; y: 13px;
        width: parent.width - 4px; height: 80px;
        background: #1d2635ee;
        border-color: #65728680;
        border-width: 1px;
        border-radius: 25px;
        Rectangle { x: 16px; y: 2px; width: parent.width - 32px; height: 1px; background: #ffffff26; }
        HorizontalLayout {
            x: 18px; y: 5px;
            width: parent.width - 36px; height: 70px;
            spacing: 9px;
            alignment: center;
            for entry[index] in root.entries: Rectangle {
                width: 58px; height: 68px; background: transparent;
                tile := Rectangle {
                    x: 5px;
                    y: hit.has-hover && root.hover-enabled ? 1px : 10px;
                    width: hit.has-hover && root.hover-enabled ? 50px : 46px;
                    height: hit.has-hover && root.hover-enabled ? 50px : 46px;
                    background: entry.is-folder ? #e6aa5b : #6678be;
                    border-color: entry.is-folder ? #ffe2a6 : #b6c9ff;
                    border-width: 1px;
                    border-radius: 14px;
                    animate x, y, width, height { duration: 170ms; easing: spring(0.13); }
                    if entry.is-folder : Rectangle {
                        x: 11px; y: 15px; width: parent.width - 22px; height: parent.height - 26px;
                        background: #fff0c9;
                        border-radius: 3px;
                        Rectangle { x: 0px; y: -5px; width: 16px; height: 7px; border-radius: 2px; background: #fff0c9; }
                    }
                    if !entry.is-folder : Text {
                        text: "◆"; font-size: 25px; color: white;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Text {
                    x: 0px; y: 56px; width: 58px; height: 13px;
                    text: entry.title;
                    color: hit.has-hover ? #ffffff : #c5d0dc;
                    font-size: 10px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                hit := TouchArea { mouse-cursor: pointer; clicked => { root.activate(index); } }
            }
        }
    }
}
