export struct DockEntry {
    title: string,
    glyph: string,
    is-folder: bool,
}
export struct FileEntry {
    title: string,
    glyph: string,
    is-folder: bool,
    exists: bool,
    path: string,
}
export struct FileRow {
    a: FileEntry,
    b: FileEntry,
    c: FileEntry,
}
export struct PinnedEntry {
    title: string,
    path: string,
    is-folder: bool,
}

export struct LauncherEntry {
    title: string,
    target: string,
    pinned: bool,
    exists: bool,
}
export struct LauncherRow {
    a: LauncherEntry,
    b: LauncherEntry,
}
