import { Button, ScrollView } from "std-widgets.slint";
import { FileEntry, FileRow } from "models.slint";

component FileTile inherits Rectangle {
    in property <FileEntry> entry;
    callback activate();
    width: 144px;
    height: 90px;
    visible: entry.exists;
    border-radius: 12px;
    background: tile-touch.has-hover ? #e9f0fa : #f5f7fb;
    border-color: tile-touch.has-hover ? #c1d7f7 : #eef1f6;
    border-width: 1px;
    if entry.is-folder : Rectangle {
        x: 56px; y: 15px; width: 32px; height: 26px;
        border-radius: 5px; background: #efb35e;
        Rectangle { x: 0px; y: -5px; width: 16px; height: 8px; border-radius: 2px; background: #f7cb83; }
    }
    if !entry.is-folder : Rectangle {
        x: 59px; y: 12px; width: 27px; height: 33px;
        background: #d8e3f5; border-radius: 4px;
        Rectangle { x: 7px; y: 13px; width: 14px; height: 2px; background: #8298b8; }
        Rectangle { x: 7px; y: 19px; width: 11px; height: 2px; background: #8298b8; }
    }
    Text {
        x: 7px; y: 52px; width: parent.width - 14px; height: 22px;
        text: entry.title; overflow: elide;
        color: #24364b; font-size: 12px;
        horizontal-alignment: center;
    }
    tile-touch := TouchArea { mouse-cursor: pointer; clicked => { root.activate(); } }
}

export component DrawerWindow inherits Window {
    width: 484px; height: 490px;
    title: "LifeTrace Drawer";
    no-frame: true; always-on-top: true; background: transparent;
    in property <[FileRow]> rows;
    in property <string> current-title: "";
    in property <string> current-path: "";
    in property <string> status-line: "";
    callback open-index(int);
    callback go-back();
    callback open-explorer();
    callback close-requested();

    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        background: #fffffffa; border-color: #dce3ee; border-width: 1px; border-radius: 20px;
        VerticalLayout {
            padding: 17px; spacing: 11px;
            HorizontalLayout {
                height: 37px; spacing: 9px;
                Rectangle {
                    width: 36px; height: 35px; border-radius: 11px;
                    background: back-hit.has-hover ? #e8eff9 : #f3f6fb;
                    Text { text: "‹"; font-size: 27px; color: #233f60; horizontal-alignment: center; vertical-alignment: center; }
                    back-hit := TouchArea { mouse-cursor: pointer; clicked => { root.go-back(); } }
                }
                Text {
                    text: root.current-title; color: #1b293a; font-size: 19px; font-weight: 650;
                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                }
                Rectangle {
                    width: 34px; height: 34px; border-radius: 11px;
                    background: close-hit.has-hover ? #f5e7e9 : #f4f6fa;
                    Text { text: "×"; color: #627082; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                    close-hit := TouchArea { mouse-cursor: pointer; clicked => { root.close-requested(); } }
                }
            }
            Text {
                text: root.current-path; color: #78899d; font-size: 11px;
                height: 20px; overflow: elide;
            }
            Rectangle { height: 1px; background: #e9edf3; }
            ScrollView {
                height: 335px;
                VerticalLayout {
                    spacing: 7px;
                    for row[index] in root.rows : HorizontalLayout {
                        height: 90px; spacing: 7px;
                        FileTile { entry: row.a; activate => { root.open-index(index * 3); } }
                        FileTile { entry: row.b; activate => { root.open-index(index * 3 + 1); } }
                        FileTile { entry: row.c; activate => { root.open-index(index * 3 + 2); } }
                    }
                }
            }
            HorizontalLayout {
                height: 30px;
                Text {
                    text: root.status-line; color: #728297; font-size: 11px;
                    horizontal-stretch: 1; vertical-alignment: center;
                }
                Button { text: "在资源管理器中打开"; clicked => { root.open-explorer(); } }
            }
        }
    }
}
